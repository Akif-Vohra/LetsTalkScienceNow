source "https://rubygems.org"

# Local development uses Jekyll 4.
# (GitHub Pages builds the site on its own servers using its supported
#  plugin set — jekyll-seo-tag, jekyll-feed, and jekyll-sitemap are all included.)
gem "jekyll", "~> 4.4"

group :jekyll_plugins do
  gem "jekyll-seo-tag"
  gem "jekyll-feed"
  gem "jekyll-sitemap"
end
